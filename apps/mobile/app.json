{
  "expo": {
    "name": "Billify",
    "slug": "billify-mobile",
    "scheme": "billify",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.billify.mobile"
    },
    "android": {
      "package": "com.billify.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
