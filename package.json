{
  "name": "invoice-saas",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "dev": "concurrently -k -n api,web 'npm run dev:api' 'npm run dev:web'",
    "dev:api": "npm run dev -w @invoice/api",
    "dev:web": "npm run dev -w @invoice/web",
    "dev:worker": "npm run dev -w @invoice/worker",
    "dev:mobile": "npm run start -w @invoice/mobile",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "tsx --env-file=.env packages/database/src/migrate.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:db": "tsx --env-file=.env packages/database/test/integration.ts",
    "build": "npm run build -w @invoice/web",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "check:mobile": "npm exec --workspace @invoice/mobile -- expo export --platform ios --platform android --output-dir dist",
    "dev:all": "concurrently -k -n api,web,worker 'npm run dev:api' 'npm run dev:web' 'npm run dev:worker'",
    "mail:up": "docker compose --profile mail up -d ses",
    "mail:down": "docker compose --profile mail stop ses"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0",
    "@playwright/test": "^1.56.0"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.1"
  },
  "type": "module"
}
