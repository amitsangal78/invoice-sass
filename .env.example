# Local development only. Never reuse these example credentials in hosted environments.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://invoice_app:invoice_local_only@127.0.0.1:5440/invoice_dev
MIGRATION_DATABASE_URL=postgresql://invoice_admin:invoice_dev_only@127.0.0.1:5440/invoice_dev
# Generate independent secrets with: openssl rand -hex 32
OTP_SECRET=replace-with-at-least-32-random-characters
DELIVERY_KEY=replace-with-64-hexadecimal-characters
DELIVERY_MODE=local
LOCAL_MAIL_DIR=.local/mail
# Optional, only for isolated DB integration tests. Never point this at Neon/production.
TEST_DATABASE_URL=postgresql://invoice_admin:invoice_dev_only@127.0.0.1:5440/invoice_test

# Razorpay provider connectivity (TEST keys only). No live payments are enabled.
PAYMENT_DRIVER=razorpay
# RAZORPAY_KEY_ID=rzp_test_your_key_id
# RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=an_independent_webhook_signing_secret

# Email provider default: local | ses-local | ses | resend
# The verified Platform Owner can override this for NEW jobs in Payment & Email Settings.
# DELIVERY_MODE=ses-local
AWS_REGION=ap-southeast-1
SES_LOCAL_ENDPOINT=http://127.0.0.1:4566
SES_LOCAL_FROM_EMAIL=invoices@local.example
# EMAIL_FROM=Invoices <invoices@your-verified-domain.example>
# AWS_PROFILE=your-ses-profile
# SES_CONFIGURATION_SET=your-configuration-set
# RESEND_API_KEY=re_your_key
# RESEND_FROM_EMAIL=Invoices <invoices@your-resend-verified-domain.example>
# LOCALSTACK_AUTH_TOKEN=your_localstack_token_if_required
